{
  "name": "@resourcehub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --project unit",
    "start": "node --enable-source-maps dist/main.js",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@resourcehub/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "testcontainers": "^11.14.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-fastify": "^11.2.9",
    "@resourcehub/contracts": "workspace:*",
    "@resourcehub/db": "workspace:*",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
