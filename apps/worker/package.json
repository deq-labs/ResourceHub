{
  "name": "@resourcehub/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps --import ./dist/instrumentation.js --env-file-if-exists=../../.env dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --project unit",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@resourcehub/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.2.5",
    "testcontainers": "^11.14.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@opentelemetry/api": "^1.10.0",
    "@resourcehub/db": "workspace:*",
    "@resourcehub/integrations": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.4.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ]
}
