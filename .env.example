# Copy to .env for local development. Every value here is LOCAL DEV ONLY.
# In Azure, these come from Key Vault references on the Container App.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL_APP=postgres://resourcehub_app:app_dev_pw@localhost:55432/resourcehub
DATABASE_URL_PLATFORM=postgres://resourcehub_platform:platform_dev_pw@localhost:55432/resourcehub
DATABASE_URL_MIGRATOR=postgres://resourcehub_migrator:migrator_dev_pw@localhost:55432/resourcehub
REDIS_URL=redis://localhost:6379

ROOT_DOMAIN=localhost
PLATFORM_HOST=admin.localhost
TRUST_PROXY=false
