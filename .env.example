# Copy to .env for local development. Every value here is LOCAL DEV ONLY.
# In Azure, these come from Key Vault references on the Container App.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL_APP=postgres://resourcehub_app:app_dev_pw@localhost:55432/resourcehub
DATABASE_URL_PLATFORM=postgres://resourcehub_platform:platform_dev_pw@localhost:55432/resourcehub
DATABASE_URL_MIGRATOR=postgres://resourcehub_migrator:migrator_dev_pw@localhost:55432/resourcehub
REDIS_URL=redis://localhost:6379

ROOT_DOMAIN=localhost
PLATFORM_HOST=admin.localhost
TRUST_PROXY=false

# Auth: `dev` = built-in OIDC provider with "sign in as"; `entra` = Microsoft Entra External ID
AUTH_PROVIDER=dev
OIDC_ISSUER=http://localhost:3000/api/v1/dev-idp
OIDC_CLIENT_ID=resourcehub-local
AUTH_JWT_SECRET=local-dev-only-secret-change-me-0123456789
COOKIE_SECURE=false
PUBLIC_SCHEME=http

# Mailpit catches outgoing mail: http://localhost:8025
SMTP_URL=smtp://localhost:1025
# `queue` hands mail to the worker (BullMQ); `direct` sends inline from the API
MAIL_TRANSPORT=queue

# Integration secrets for the local mocks. In Azure these are Key Vault secrets (secret_ref kv:...).
PARTNER_SOAP_PASSWORD=partner-demo-password
PARTNER_FEED_TOKEN=demo-feed-token
